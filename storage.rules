rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /school-media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }
    match /private-documents/{allPaths=**} {
      allow read, write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
